pkgname=dotfiles-foot
pkgver=0.0.7
pkgrel=1
pkgdesc="Provide base foot configuration."
arch=('any')
license=('MIT')
depends=(
  'foot'
  'noto-fonts-emoji'
  'ttf-meslo-nerd'
)
source=(
  'foot.ini'
)
sha256sums=(
  'SKIP'
)

package() {
  install -Dm644 "$srcdir/foot.ini" "$pkgdir/usr/share/dotfiles/.config/foot/foot.ini"
}
